{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "web/mobile-app/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    { "src": "/", "dest": "/web/mobile-app/index.html" },
    {
      "src": "/sw.js",
      "dest": "/web/mobile-app/sw.js",
      "headers": { "cache-control": "public, max-age=0, must-revalidate" }
    },
    { "src": "/(.*)", "dest": "/web/mobile-app/$1" },
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/web/mobile-app/index.html" }
  ]
}
