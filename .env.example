NODE_ENV=development
PORT=4000

# Local dev: run `docker compose up -d` then use this connection string.
DATABASE_URL=postgresql://digiscript:digiscript@localhost:5432/digiscript?schema=public

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

LOCAL_STORAGE_DIR=.data/documents

# PRD 4.4 confidence thresholds
AI_CATEGORIZATION_HIGH_CONFIDENCE=0.85
AI_CATEGORIZATION_LOW_CONFIDENCE=0.7

# PRD 4.7 chat/query confidence threshold for auto-escalation
QUERY_LOW_CONFIDENCE=0.7
