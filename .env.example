NODE_ENV=development
PORT=4000

# Local dev: run `docker compose up -d` then use this connection string.
DATABASE_URL=postgresql://digiscript:digiscript@localhost:5432/digiscript?schema=public

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Comma-separated browser origins allowed to call this API. Leave unset in
# local development (any origin is accepted). Always set it on a deployment,
# to the frontend's origin — e.g. https://your-app.vercel.app
# CORS_ORIGIN=

LOCAL_STORAGE_DIR=.data/documents

# Demo mode offers the seeded logins through GET /demo/personas so both apps
# can show a one-click role picker under their normal login form. No password
# is sent to the browser. It currently defaults to ON, since every deployment
# is a demo deployment. Turn it off before real learner data is involved:
# DEMO_MODE=false

# PRD 4.4 confidence thresholds
AI_CATEGORIZATION_HIGH_CONFIDENCE=0.85
AI_CATEGORIZATION_LOW_CONFIDENCE=0.7

# PRD 4.7 chat/query confidence threshold for auto-escalation
QUERY_LOW_CONFIDENCE=0.7
